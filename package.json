{
  "name": "@bendarbinian/api-resource",
  "version": "0.1.1",
  "description": "A lightweight library for building typed API resources from domain data, with first-class TypeScript support.",
  "keywords": [
    "api",
    "resource",
    "response",
    "typed-resources",
    "serialization",
    "typescript"
  ],
  "homepage": "https://github.com/BenDarbinian/api-resource#readme",
  "bugs": {
    "url": "https://github.com/BenDarbinian/api-resource/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenDarbinian/api-resource.git"
  },
  "license": "MIT",
  "author": "Ben Darbinian",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "prepack": "npm test",
    "test": "npm run build && npm run test:types && node --test test/resource.test.js",
    "test:types": "tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
